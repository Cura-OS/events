{
  "name": "@curaos/events",
  "description": "CuraOS typed event schema contracts for event-led architecture.",
  "version": "0.1.0",
  "devDependencies": {
    "@curaos/tsconfig": "0.0.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
